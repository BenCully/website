{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev server",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "source \"$HOME/.nvm/nvm.sh\" && nvm use && yarn dev",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ]
}
